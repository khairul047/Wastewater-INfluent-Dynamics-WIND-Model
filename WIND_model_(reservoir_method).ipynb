   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "c322d18e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set working directory\n",
    "#os.chdir(r\"insert working directory\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "6c4438c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# insert weekly fraction for domestic and industrial\n",
    "dom_weekly_fraction = {\n",
    "    \"Mon\": 1.0,\n",
    "    \"Tue\": 1.0,\n",
    "    \"Wed\": 1.0,\n",
    "    \"Thu\": 1.0,\n",
    "    \"Fri\": 1.0,\n",
    "    \"Sat\": 0.95,\n",
    "    \"Sun\": 0.95\n",
    "}\n",
    "\n",
    "ind_weekly_fraction = {\n",
    "    \"Mon\": 1.0,\n",
    "    \"Tue\": 1.0,\n",
    "    \"Wed\": 1.0,\n",
    "    \"Thu\": 1.0,\n",
    "    \"Fri\": 1.2,\n",
    "    \"Sat\": 0.25,\n",
    "    \"Sun\": 0.25\n",
    "}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "8deda944",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Get day from the input file\n",
    "\n",
    "# Read the CSV file\n",
    "file_path = \"./input/input_file.csv\"        # Adjust path as needed\n",
    "df = pd.read_csv(file_path, parse_dates=[\"Date\"])  # read the data\n",
    "\n",
    "# Get day of the week\n",
    "df[\"Day\"] = df[\"Date\"].dt.strftime(\"%a\")           # e.g., 'Mon', 'Tue'\n",
    "\n",
    "# Map to weekly fraction for domestic\n",
    "df[\"dom_weekly_fraction\"] = df[\"Day\"].map(dom_weekly_fraction)\n",
    "\n",
    "# Map to weekly fraction for industrial\n",
    "df[\"ind_weekly_fraction\"] = df[\"Day\"].map(ind_weekly_fraction)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "3a485e1f",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Calculate domestic flow\n",
    "pop = 550000          # number of population in the sewershed\n",
    "q = 0.28             # domestic wastewater production per population per day (m3/pop.day)\n",
    "\n",
    "# Calculate Domestic Flow\n",
    "df[\"Q_domestic\"] = pop * q * df[\"dom_weekly_fraction\"]\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "161d4567",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Calculate Industrial flow\n",
    "\n",
    "Qind_daily = 2400;               # daily industrial wastewater production (m3/d)\n",
    "\n",
    "# Calculate Industrial Flow\n",
    "df[\"Q_industrial\"] = Qind_daily * df[\"ind_weekly_fraction\"]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "metadata": {},
   "outputs": [],
   "source": [
    "### Calculate rainfall-drived inflow\n",
    "\n",
    "K_imp = 1600    # co-efficient to convert rainfall to direct runoff (how much runoff is generated from 1 mm rainfall) \n",
    "\n",
    "df[\"Q_imp\"] = K_imp * df[\"Rainfall (mm/day)\"]\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "6cdab134",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Calculate  infiltration\n",
    "\n",
    "# Parameters\n",
    "a_loss = 0.03  \n",
    "a_inf = 0.07  \n",
    "\n",
    "# Initialize\n",
    "h = 0\n",
    "\n",
    "\n",
    "# Lists to store results\n",
    "h_list = []\n",
    "inf_list = []\n",
    "\n",
    "h_inf_init = 2  #2\n",
    "\n",
    "\n",
    "K_inf =44500  # a scaling parameter representing the infiltration gain (m3/mm)\n",
    "\n",
    "\n",
    "\n",
    "for rain in df[\"Rainfall (mm/day)\"]:\n",
    "    # Add  rainfall \n",
    "    h += rain \n",
    "\n",
    "    # Step 2 — Compute infiltration and percolation (same day)\n",
    "        \n",
    "    if h < h_inf_init:\n",
    "        inf = 0\n",
    "    else:\n",
    "        inf = a_inf *( h -h_inf_init)\n",
    "\n",
    "    loss = a_loss * h\n",
    "\n",
    "    # Step 3 — Update h after outflows\n",
    "    \n",
    "    h = h - inf - loss \n",
    "\n",
    "    # Step 7 — Store results\n",
    "    h_list.append(h)\n",
    "  \n",
    "    inf_list.append(inf)\n",
    "\n",
    "# Add results to DataFrame\n",
    "df[\"h\"] = h_list  \n",
    "\n",
    "df[\"inf_list\"] = inf_list\n",
    "\n",
    "#  Calculate infiltration flow\n",
    "\n",
    "df[\"Q_inf\"] = df[\"inf_list\"]*K_inf\n",
    "\n",
    "## Apply seasonal correction factor using influent data\n",
    "alpha = 0.3\n",
    "df[\"SCF\"] =df[\"seasonal\"]**alpha\n",
    "\n",
    "\n",
    "\n",
    "df[\"Q_inf\"] = df[\"Q_inf\"] * df[\"SCF\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "49715543",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Calculate influent and save the file \n",
    "df[\"Influent (m3/day)\"] = df[\"Q_domestic\"] + df[\"Q_industrial\"] + df[\"Q_imp\"] + df[\"Q_inf\"]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "6d31d61a",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Sewer Transport\n",
    "kr = 1.05\n",
    "# Initial condition:\n",
    "#Qout,0 = Qin,1\n",
    "Qout_prev = df.loc[df.index[0], "Influent (m3/day)"]\n",
    "dt = 1.0\n",
    "Q_out_series = []",
    "\n",
    "\n",
    "for t in range(len(df)):\n",
    "    \n",
    "    # Current inflow\n",
    "    Q_in = df.loc[df.index[t], "Influent (m3/day)"]\n",
    "    # Numerical routing solution\n",
    "    # Numerical routing solution\n",
    "    # Qout,j = (kr*Qout,j-1 + dt*Qin,j) / (kr + dt)\n",
    "    \n",
    "    Q_out = (kr * Qout_prev + dt * Q_in) / (kr + dt)\n",
    "\n",
    "    # Store result\n",
    "    Q_out_series.append(Q_out)\n",
    "    # Update previous outflow\n",
    "    Qout_prev = Q_out\n",
    "\n",
    
    "df[\"Discharge_sewer m3/day\"] = Q_out_series\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "53958aab",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "#df[\"Discharge_sewer m3/day\"] = Q_influent"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "d2654101",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# convert m3/day to MGD\n",
    "conversion_MGD_2_m3pD = 3785.41; # convert MGD to m3/day\n",
    "\n",
    "df[\"Influent (MGD)\"] = df[\"Discharge_sewer m3/day\"] /conversion_MGD_2_m3pD\n",
    "\n",
    "df.to_csv(\"output/Influent.csv\", index=False)\n",
    "\n"
   ]
  }
 ],
